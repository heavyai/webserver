						"id": "f83069bb-cdf4-4864-8ce6-8e12333a5358",
						"exec": [
							"pm.test(\"response is 200 ok\", function () {",
							"    pm.response.to.be.ok",
							"})",
							"pm.test(\"response body has expected servers config structure\", function () {",
							"    const body = pm.response.json()",
							"    pm.expect(body.length).to.eq(1)",
							"    const serversConfig = body[0]",
							"    const configKeys = Object.keys(serversConfig)",
							"    const expectedKeys = ['database', 'host', 'master', 'password', 'port', 'username']",
							"    configKeys.each(k => {",
							"        pm.expect(expectedKeys.includes(k))",
							"    })",
							"})",
							"pm.test(\"response body no longer has modified username\", function () {",
							"    const body = pm.response.json()",
							"    pm.expect(body.length).to.eq(1)",
							"    const serversConfig = body[0]",
							"    pm.expect(serversConfig.username != \"Tutela\")",
							"})",
							"pm.test(\"response does not have servers-json cookie\", function () {",
							"    pm.expect(getCookie(\"servers-json\")).to.not.be.ok",
							"})",
							"",
							"function getCookie(cookieName) {",
							"    let cookies = []",
							"    pm.response.headers.each((header) => {",
							"        if (header.key === \"Set-Cookie\") {",
							"            cookies.push(header.value)",
							"        }",
							"    })",
							"    ",
							"    return cookies.find((cookie) => cookie.startsWith(cookieName + \"=\"))",
							"}"
						],
						"type": "text/javascript"
					}
				}
			],
