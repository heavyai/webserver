{
	"info": {
		"_postman_id": "270adf3d-54f7-49bb-9c00-0f87ec5aca55",
		"name": "Metrics",
		"description": "Testing for Metrics features that requires OWS to be running w/ the `enable-metrics=true` flag to be set.",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"item": [
		{
			"name": "Successful Session Create",
			"event": [
				{
					"listen": "test",
					"script": {
						"id": "42c8ce9f-d342-415f-9fb5-d3218cd5dfc4",
						"exec": [
							"pm.test(\"response is 201 created\", function () {",
							"    pm.response.to.have.status(201);",
							"})",
							"pm.test(\"response has owu (user identification) cookie\", function () {",
							"    pm.expect(getCookie(\"owu\")).to.be.ok",
							"})",
							"",
							"function getCookie(cookieName) {",
							"    let cookies = []",
							"    pm.response.headers.each((header) => {",
							"        if (header.key === \"Set-Cookie\") {",
							"            cookies.push(header.value)",
							"        }",
							"    })",
							"    ",
							"    return cookies.find((cookie) => cookie.startsWith(cookieName + \"=\"))",
							"}"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Accept",
						"type": "text",
						"value": "application/json"
					},
					{
						"key": "Content-Type",
						"name": "Content-Type",
						"type": "text",
						"value": "application/json"
					},
					{
						"key": "Cookie",
						"value": "owb=9041c23c-cc38-41cd-80f1-fb01fe74443f; Path=/; Domain=localhost; HttpOnly; Expires=Sun, 07 Apr 2030 15:11:51 GMT;",
						"type": "text"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\"username\":\"{{LDAPUsername}}\",\"password\":\"{{LDAPPassword}}\",\"dbName\":\"mapd\"}"
				},
				"url": {
					"raw": "http://localhost:6273/session/create",
					"protocol": "http",
					"host": [
						"localhost"
					],
					"port": "6273",
					"path": [
						"session",
						"create"
					]
				}
			},
			"response": []
		},
